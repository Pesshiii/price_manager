{
    # Railway сам терминирует HTTPS и отдаёт нам HTTP; ничего шифровать не надо.
    auto_https off
    admin off
}

:{$PORT} {
    encode gzip zstd

    # handle-блоки mutually exclusive: один запрос обрабатывает ровно
    # один блок и default-directive-order не применяется. Без этого
    # try_files (который стоит до reverse_proxy в default order)
    # переписывал /api/* → /index.html ДО того как @backend матчил
    # путь, и POST-запросы к API улетали в file_server, который
    # отвечал 405 Allow: GET, HEAD.
    @backend {
        path /api/* /admin/* /static/* /media/*
    }
    handle @backend {
        reverse_proxy {$DJANGO_UPSTREAM} {
            header_up Host {host}
            # Railway терминирует HTTPS на edge и пересылает нам по HTTP
            # внутри приватной сети, поэтому {scheme} == "http". Django с
            # SECURE_SSL_REDIRECT=True увидел бы http и сделал 301 →
            # POST превращается в GET → 405. Снаружи Railway всегда
            # HTTPS, поэтому захардкодим.
            header_up X-Forwarded-Proto https
        }
    }

    # Всё остальное — SPA: статика из /srv/, неизвестные пути ↦ index.html.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
