# The location block of the price_manager site in nginx on the host. Only the
# proxy_* lines matter; keep the server's existing listen/ssl/server_name and
# its client_max_body_size and proxy_*_timeout values.
#
# Before reloading nginx with this, the domain must already be in ALLOWED_HOSTS
# and deployed (deploy/README.md, steps 1 and 3): Django answers 400 to a Host
# it does not know.

location / {
    # 127.0.0.1, not localhost: web is published on IPv4 loopback only, and
    # localhost may resolve to ::1 first.
    proxy_pass http://127.0.0.1:8000;

    # Without these Django sees Host 127.0.0.1:8000.
    proxy_set_header Host              $host;
    # USE_X_FORWARDED_HOST = True (settings/base.py) trusts this header, so nginx
    # must set it, overriding whatever the client sent.
    proxy_set_header X-Forwarded-Host  $host;
    # SECURE_PROXY_SSL_HEADER (settings/base.py): with DEBUG=false, a request
    # without it is redirected to https forever.
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP         $remote_addr;
}
