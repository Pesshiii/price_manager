# /etc/pm-deploy.env: settings of pm-deploy and pm-notify.
# Holds webhook and bot secrets: root:<group of the deploy user>, mode 640.

# The production checkout (the directory with docker-compose.yml and .env).
APP_DIR=/opt/price_manager
# The public domain; the post-deploy check sends it as Host.
DOMAIN=pm.example.kz
# Must match WEB_PORT in the checkout's .env.
WEB_PORT=8000

# Where messages go: every channel filled in below. None: the journal only.
# Bitrix24: an inbound webhook with the «Мессенджер (im)» scope, ending in /,
# and the Bitrix24 user ID of the recipient.
B24_WEBHOOK=
B24_USER_ID=
# Telegram: a personal bot and chat. TG_PROXY when the server cannot reach
# api.telegram.org itself, e.g. socks5h://user:pass@host:1080.
TG_TOKEN=
TG_CHAT_ID=
#TG_PROXY=

# 1: also report every successful deploy, not only stops and failures.
NOTIFY_SUCCESS=0
# Seconds of failing `git fetch` before a message (a permission error is
# reported at once). Default 1800.
#FETCH_ALERT_AFTER=1800
